# Postgres connection string from your Neon project (Dashboard > Connection Details)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# Resend API key (resend.com/api-keys). Verify a domain there, or use resend.dev for testing.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=postcards@yourdomain.com

# Vercel Blob token (vercel.com/dashboard/stores, or `vercel blob` CLI). Only needed
# outside Vercel deploys where it isn't injected automatically.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
